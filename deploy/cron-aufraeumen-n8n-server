# Borg läuft ausschließlich auf dem Backupserver. Der Hauptserver besitzt keinen Repo-Zugang.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
40 * * * * root /usr/bin/python3 -B /opt/flipbase-backup/backup-server.py >> /var/log/flipbase-backup-pull.log 2>&1
15 4 * * * root /usr/bin/python3 -B /opt/flipbase-backup/backup-server.py --cleanup-legacy >> /var/log/flipbase-backup-retention.log 2>&1
