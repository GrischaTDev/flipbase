# Entfernt ausgelagerte Flipbase-Sicherungen, die aelter als 30 Tage sind.
#
# Bewusst hier und nicht auf dem Flipbase-Server: Dessen Schluessel darf nur
# hinzufuegen. So kann ein Angreifer dort die Kopien nicht mit loeschen.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
15 4 * * * root find /srv/flipbase-backup/daten -type f -name '*.age' -mtime +30 -delete
