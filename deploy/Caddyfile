# ---------------------------------------------------------------------------
# api.flipbase.de - Supabase
#
# Die API-Pfade sind oeffentlich: Sie sind durch Schluessel und RLS geschuetzt
# und werden von der Anwendung im Browser aufgerufen.
#
# Alles uebrige ist Supabase Studio - die Datenbank-Verwaltung. Davor sitzt
# Authelia mit Anmeldeseite und zweitem Faktor.
# ---------------------------------------------------------------------------
{$PROXY_DOMAIN} {
	@supabase_api path /auth/v1/* /rest/v1/* /graphql/v1 /realtime/v1/* /storage/v1/* /functions/v1/* /mcp /sso/*

	handle @supabase_api {
		reverse_proxy api-gw:8000
	}

	handle {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}

		reverse_proxy studio:3000
	}

	header -server
}

# ---------------------------------------------------------------------------
# auth.flipbase.de - die Anmeldeseite selbst.
# Muss ohne vorgelagerte Pruefung erreichbar sein, sonst koennte sich
# niemand anmelden.
# ---------------------------------------------------------------------------
auth.flipbase.de {
	reverse_proxy authelia:9091

	header X-Robots-Tag "noindex, nofollow"
	header -server
}

# ---------------------------------------------------------------------------
# app.flipbase.de - Flipbase
# Die Sicherheits-Header setzt nginx im Container selbst (Phase 7),
# deshalb reicht Caddy die Antwort unveraendert durch.
# ---------------------------------------------------------------------------
app.flipbase.de {
	reverse_proxy flipbase-web:80

	# Verwaltungsoberflaeche gehoert nicht in Suchmaschinen.
	header X-Robots-Tag "noindex, nofollow"
	header -server
}

# ---------------------------------------------------------------------------
# flipbase.de - statische Landingpage.
# www leitet auf die nackte Domain, damit es spaeter nur eine Adresse gibt.
# ---------------------------------------------------------------------------
www.flipbase.de {
	redir https://flipbase.de{uri} permanent
	header -server
}

flipbase.de {
	root * /srv/landing
	# Besucher fordern "/" an, nicht "/index.html" - die Aufloesung auf die
	# Datei passiert erst im file_server, nach den Matchern. Ein Matcher auf
	# den exakten Pfad "/index.html" traf deshalb nie zu.
	@seite path / /index.html
	file_server
	encode zstd gzip

	header {
		-server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Die Seite laedt nichts von fremden Servern, bringt aber seit der
		# Bewerbungsanbindung genau ein eingebettetes Skript mit (siehe
		# landing/landing.js). Es wird ausschliesslich von derselben Herkunft
		# geladen; eingebettete Skripte und fremde Skriptquellen bleiben gesperrt.
		# connect-src erlaubt den fetch-Aufruf des Formulars zur Edge Function.
		# form-action 'none': kein Formular der Seite hat noch ein action-Attribut
		# (das Skript sendet alles per fetch). 'none' ist strenger als eine feste
		# Ziel-Adresse - liefe das Skript einmal nicht, wuerde ein natives Absenden
		# sonst blind Richtung app.flipbase.de gehen und die Eingaben verlieren.
		Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self' https://api.flipbase.de; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
	}

	header @seite {
		Cache-Control "no-cache"
	}

	header /fonts/* Cache-Control "public, max-age=31536000, immutable"
}
