# Vorlage für /opt/flipbase-marketplace/marketplace-worker.env auf dem Server.
# Keine echten Schlüssel in diese Datei oder ins Repository schreiben.
MARKETPLACE_BROWSER_TEST_ENABLED=1
MARKETPLACE_BROWSER_PROVIDER=gologin
# Verbundene Konten erhalten standardmäßig 15 Minuten; 0 pausiert den gesamten Dienst.
MARKETPLACE_SCHEDULED_SYNC_ENABLED=1
SUPABASE_URL=http://api-gw:8000
SUPABASE_ANON_KEY=REPLACE_ON_SERVER
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ON_SERVER
GOLOGIN_API_TOKEN=REPLACE_ON_SERVER

# Chromium-Pilot: Compose setzt Provider, Profilpfade, Hostkennung und Pilotflags.
# MARKETPLACE_CHROMIUM_IMAGE benötigt ein geprüftes :sha-<40 Zeichen>-Tag oder @sha256.
# FLIPBASE_MARKETPLACE_IMAGE, MARKETPLACE_CHROMIUM_IMAGE und MARKETPLACE_DOCKER_GROUP_ID
# für Compose in der privaten Serverumgebung setzen; keine echten Werte in Git.
# Direkter Serverausgang ist eine bewusste Pilotwahl, kein zugesicherter Vinted-Zugang.
# MARKETPLACE_CHROMIUM_NETWORK_ID=direct
# Optionaler privater Proxyzugang, Datei mit 0600 und Eigentümer UID 1000:
# MARKETPLACE_CHROMIUM_NETWORK_FILE=/run/flipbase/chromium-networks.json
# Automatischer lesender Abgleich bereits gekaufter deutscher ISP-Dedicated-IPs.
# Dafür persistente Netzwerkdatei mit Schreibzugriff, UID 1000 und Modus 0600 nutzen.
# IPROYAL_API_TOKEN=REPLACE_ON_SERVER
# Nach Migration und geprüftem Worker-Rollout aktivieren: genau eine deutsche
# Dedicated-ISP-IP für 30 Tage über eine hinterlegte Zahlungsart (auch PayPal).
# Keine automatische Verlängerung; unklare Zahlungsantworten sperren weitere Käufe.
IPROYAL_AUTO_PURCHASE_ENABLED=0
# Private Anbieter-ID aus GET /cards; kein Rückfall auf Guthaben.
# IPROYAL_PAYMENT_METHOD_ID=REPLACE_ON_SERVER
# Gesamtpreisangebot einschließlich Steuern; höchstens 8 USD, niedrigere Werte sind möglich.
IPROYAL_MAX_PRICE_USD=8
