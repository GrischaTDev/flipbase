# Vorlage für /opt/flipbase-marketplace/marketplace-worker.env auf dem Server.
# Keine echten Schlüssel in diese Datei oder ins Repository schreiben.
MARKETPLACE_BROWSER_TEST_ENABLED=1
MARKETPLACE_BROWSER_PROVIDER=gologin
# Erst nach geprüftem Worker-Rollout auf 1 setzen. Accounts bleiben einzeln freizugeben.
MARKETPLACE_SCHEDULED_SYNC_ENABLED=0
SUPABASE_URL=http://api-gw:8000
SUPABASE_ANON_KEY=REPLACE_ON_SERVER
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ON_SERVER
GOLOGIN_API_TOKEN=REPLACE_ON_SERVER
