# Nur auf dem Server mit root:root und Modus0600 bereitstellen; keine Werte committen.
SUPABASE_URL=https://api.flipbase.de
SUPABASE_SERVICE_ROLE_KEY=
WEB_PUSH_ENABLED=false
WEB_PUSH_ALLOW_ALL=false
WEB_PUSH_PILOT_USER_IDS=
WEB_PUSH_PILOT_DEVICE_IDS=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@flipbase.de
WEB_PUSH_VAPID_KEY_ID=
WEB_PUSH_ALLOWED_ORIGINS=https://app.flipbase.de
# Fuer den internen eBay-Beobachter dieselben Serverwerte wie beim bestehenden OAuth-Dienst verwenden.
# OAuth-Tokens selbst werden hier niemals eingetragen.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI_NAME=
EBAY_TOKEN_ENCRYPTION_KEY=
EBAY_APP_URL=https://app.flipbase.de
EBAY_ENVIRONMENT=production
EBAY_DELETION_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=
