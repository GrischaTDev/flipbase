{
  "manifest_version": 3,
  "name": "Flipbase Listing-Assistent",
  "version": "1.0.3",
  "description": "Überträgt Inserate aus Flipbase per 1-Klick automatisiert und sicher auf Kleinanzeigen.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["flipbase-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.kleinanzeigen.de/p-anzeige-aufgeben-schritt2.html*",
        "https://kleinanzeigen.de/p-anzeige-aufgeben-schritt2.html*"
      ],
      "js": ["autofill-core.js", "kleinanzeigen-autofill.js"],
      "css": ["autofill.css"],
      "run_at": "document_idle"
    }
  ]
}
