{
  "manifest_version": 3,
  "name": "Flipbase Listing-Assistent",
  "version": "1.8.0",
  "description": "Verbindet Dein Vinted-Postfach mit Flipbase und unterstützt Kleinanzeigen-Inserate.",
  "icons": {
    "16": "images/flipbase-mark-16.png",
    "32": "images/flipbase-mark-32.png",
    "48": "images/flipbase-mark-48.png",
    "128": "images/flipbase-mark-128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/flipbase-mark-16.png",
      "24": "images/flipbase-mark-24.png",
      "32": "images/flipbase-mark-32.png"
    },
    "default_title": "Flipbase Listing-Assistent"
  },
  "permissions": ["storage", "activeTab", "alarms"],
  "host_permissions": [
    "https://www.vinted.de/*",
    "https://www.kleinanzeigen.de/*",
    "https://kleinanzeigen.de/*",
    "https://api.flipbase.de/*",
    "http://127.0.0.1:54351/*",
    "http://localhost:54351/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.flipbase.de/*",
        "https://flipbase.de/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["vinted-local-core.js", "flipbase-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.vinted.de/*"],
      "js": [
        "vinted-local-inbox-events.js",
        "vinted-negotiation-runtime.js",
        "vinted-local-negotiation.js",
        "vinted-local-core.js",
        "vinted-local-messages.js",
        "vinted-local-favorites.js",
        "vinted-local-content.js",
        "vinted-local-account.js"
      ],
      "css": ["vinted-local-content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.kleinanzeigen.de/p-anzeige-aufgeben-schritt2.html*",
        "https://kleinanzeigen.de/p-anzeige-aufgeben-schritt2.html*"
      ],
      "js": ["autofill-core.js", "kleinanzeigen-autofill.js"],
      "css": ["autofill.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/flipbase-mark.png"],
      "matches": ["https://www.vinted.de/*"]
    }
  ]
}
