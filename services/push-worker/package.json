{
  "name": "@flipbase/push-worker",
  "private": true,
  "packageManager": "npm@11.13.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.13.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/web-push": "3.6.4",
    "typescript": "7.0.2"
  }
}
