{
  "name": "flipbase",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "version:generieren": "node scripts/version-generieren.mjs",
    "postinstall": "node scripts/version-generieren.mjs",
    "prestart": "node scripts/version-generieren.mjs",
    "prebuild": "node scripts/version-generieren.mjs",
    "pretest": "node scripts/version-generieren.mjs",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "docker:build": "docker compose -f docker/docker-compose.yml build",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:restart": "docker compose -f docker/docker-compose.yml down && docker compose -f docker/docker-compose.yml up -d --build"
  },
  "private": true,
  "packageManager": "npm@11.5.2",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@lucide/angular": "^1.31.0",
    "@ngx-translate/core": "^18.0.0",
    "@supabase/supabase-js": "^2.112.3",
    "browser-image-compression": "^2.0.2",
    "chart.js": "4.5.1",
    "exifr": "^7.1.3",
    "jsbarcode": "^3.12.3",
    "jszip": "^3.10.1",
    "ngx-image-cropper": "^9.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "supabase": "^2.114.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
